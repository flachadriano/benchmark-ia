# Configuração local do backend.
# Em contêiner, estas variáveis são fornecidas pelo docker-compose.yml.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://app:changeme@localhost:5432/benchmark
# Alternativa ao DATABASE_URL (lidos pelo pg e pelo node-pg-migrate):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=app
# PGPASSWORD=changeme
# PGDATABASE=benchmark
JWT_SECRET=changeme
JWT_EXPIRES_IN=8h
BCRYPT_SALT=10
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:8080
